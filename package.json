{
  "name": "dsh-laya",
  "version": "0.1.4",
  "description": "Laya typed decisions (noul / choice / score) as a first-class Cordis service and model-visible tools for DeepSeek Harness.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "laya",
    "decision-model",
    "system-one",
    "typed-decisions"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "plan.js",
    "sidecar.js",
    "SKILL.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-laya.git"
  },
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-laya/issues"
  },
  "homepage": "https://github.com/PerryLink/dsh-laya#readme",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
